        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class FiguraFlyweight {\n        &lt;&lt;interface&gt;&gt;\n        +crearFigura(int x, int y, int ancho, int alto)\n    }\n\n    class FiguraConcreta {\n        -String tipoFigura\n        -String orientacion\n        -String colorBorde\n        -String colorRelleno\n        +FiguraConcreta(String tipoFigura, String orientacion, String colorBorde, String colorRelleno)\n        +crearFigura(int x, int y, int ancho, int alto)\n        +getTipoFigura() String\n        +getOrientacion() String\n        +getColorBorde() String\n        +getColorRelleno() String\n    }\n\n    class FiguraUnshared {\n        -String detalle\n        -int grosorBorde\n        +FiguraUnshared(String detalleUnico, int grosorBordeEspecial)\n        +crearFigura(int x, int y, int ancho, int alto)\n    }\n\n    class FiguraFactory {\n        -static List~FiguraConcreta~ listaFiguras\n        +obtenerFigura(String tipo, String orientacion, String colorBorde, String colorRelleno) FiguraFlyweight\n        +getCantidadFiguras() int\n    }\n\n    class Cliente {\n        +main(String[] args)$\n    }\n\n    FiguraFlyweight &lt;|.. FiguraConcreta\n    FiguraFlyweight &lt;|.. FiguraUnshared\n    FiguraFactory --&gt; FiguraConcreta : crea y almacena\n    Cliente --&gt; FiguraFactory : solicita\n    Cliente --&gt; FiguraFlyweight : utiliza\n    Cliente --&gt; FiguraUnshared : instancia directamente&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="BdxwURpMO5WDU0saQbSH-1">
