<mxfile host="app.diagrams.net">
  <diagram name="Página-1" id="7eSo8UL7PQ8GB5wiX67-">
    <mxGraphModel dx="2060" dy="2484" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ----------------------------------------------------\n    %% PATRÓN ADAPTER Y CLIENTE PRINCIPAL\n    %% ----------------------------------------------------\n    \n    class Main {\n        +main(args: String[])\n    }\n\n    class Cliente {\n        +objEntrada: Entrada\n        +objSalida: Salida\n        +objOperacion: Operacion\n        -target: Target\n        +Cliente(fabrica: FabricaEntradaSalida, operacion: Operacion)\n        +leer(): String\n        +enviarTexto(texto: String)\n        +enviarNumero(resultado: int)\n        +calcular(): int\n    }\n\n    class Target {\n        &lt;&lt;interface&gt;&gt;\n        +convertirInt(): int\n    }\n\n    class Adaptador {\n        -adaptado: Adaptee\n        +Adaptador(adaptado: Adaptee)\n        +convertirInt(): int\n    }\n\n    class Adaptee {\n        +cliente: Cliente\n        +Adaptee(cliente: Cliente)\n        +leerString(): String\n    }\n\n    %% Relaciones del Patrón Adapter\n    Main --&gt; Cliente : instancia y ejecuta\n    Cliente *-- Target : delega conversión\n    Adaptador ..|&gt; Target : implementa\n    Adaptador o-- Adaptee : envuelve (composición)\n    Adaptee --&gt; Cliente : invoca leer() (callback)\n\n    %% ----------------------------------------------------\n    %% SUBSISTEMA DE FÁBRICAS (ABSTRACT FACTORY)\n    %% ----------------------------------------------------\n\n    class FabricaEntradaSalida {\n        &lt;&lt;interface&gt;&gt;\n        +crearEntrada(): Entrada\n        +crearSalida(): Salida\n    }\n\n    class FabricaConsola {\n        +crearEntrada(): Entrada\n        +crearSalida(): Salida\n    }\n\n    class FabricaSwing {\n        +crearEntrada(): Entrada\n        +crearSalida(): Salida\n    }\n\n    class FabricaArchivo {\n        +crearEntrada(): Entrada\n        +crearSalida(): Salida\n    }\n\n    FabricaConsola ..|&gt; FabricaEntradaSalida\n    FabricaSwing ..|&gt; FabricaEntradaSalida\n    FabricaArchivo ..|&gt; FabricaEntradaSalida\n    Cliente --&gt; FabricaEntradaSalida : usa para construir interfaces\n\n    %% ----------------------------------------------------\n    %% PRODUCTOS DE INTERFAZ (ENTRADA Y SALIDA)\n    %% ----------------------------------------------------\n\n    class Entrada {\n        &lt;&lt;interface&gt;&gt;\n        +leer(): String\n    }\n    class EntradaConsola\n    class EntradaSwing\n    class EntradaArchivo\n    EntradaConsola ..|&gt; Entrada\n    EntradaSwing ..|&gt; Entrada\n    EntradaArchivo ..|&gt; Entrada\n\n    class Salida {\n        &lt;&lt;interface&gt;&gt;\n        +salidaTexto(texto: String)\n        +salidaNumero(resultado: int)\n    }\n    class SalidaConsola\n    class SalidaSwing\n    class SalidaArchivo\n    SalidaConsola ..|&gt; Salida\n    SalidaSwing ..|&gt; Salida\n    SalidaArchivo ..|&gt; Salida\n\n    Cliente *-- Entrada : posee\n    Cliente *-- Salida : posee\n\n    %% ----------------------------------------------------\n    %% SUBSISTEMA LÓGICO (STRATEGY)\n    %% ----------------------------------------------------\n\n    class Operacion {\n        &lt;&lt;interface&gt;&gt;\n        +calcular(a: int, b: int): int\n    }\n\n    class Suma {\n        +calcular(a: int, b: int): int\n    }\n\n    class Multiplicacion {\n        +calcular(a: int, b: int): int\n    }\n\n    Suma ..|&gt; Operacion\n    Multiplicacion ..|&gt; Operacion\n    Cliente *-- Operacion : delega cálculo matemático&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CL7UJAc4yc0Hu61SO04A-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;Main&lt;/b&gt;" mermaidId="n:Main" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;Main&lt;/b&gt;" id="CL7UJAc4yc0Hu61SO04A-2">
