        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Vehiculo {\n        # String id\n        # String tipoVehiculo\n        # LocalDateTime horaEntrada\n        # LocalDateTime horaSalida\n        # double pago\n        + Vehiculo()\n        + Vehiculo(String id, String tipoVehiculo, LocalDateTime horaEntrada, LocalDateTime horaSalida)\n        + abstract double cobrar()\n        + Memento crearMemento()\n        + void restoreFromMemento(Memento memento)\n        + String getId()\n        + void setId(String id)\n        + String getTipoVehiculo()\n        + LocalDateTime getHoraEntrada()\n        + void setHoraEntrada(LocalDateTime horaEntrada)\n        + LocalDateTime getHoraSalida()\n        + void setHoraSalida(LocalDateTime horaSalida)\n        + double getPago()\n        + void setPago(double pago)\n        + String toString()\n    }\n\n    class Carro {\n        - double tarifa\n        + Carro()\n        + Carro(String id, LocalDateTime horaEntrada, LocalDateTime horaSalida)\n        + double cobrar()\n    }\n\n    class Moto {\n        - double tarifa\n        + Moto()\n        + Moto(String id, LocalDateTime horaEntrada, LocalDateTime horaSalida)\n        + double cobrar()\n    }\n\n    class Bus {\n        - double tarifa\n        + Bus()\n        + Bus(String id, LocalDateTime entrada, LocalDateTime salida)\n        + double cobrar()\n    }\n\n    class Memento {\n        - LocalDateTime horaEntradaGuardada\n        - LocalDateTime horaSalidaGuardada\n        - LocalDate fechaGuardada\n        - double pagoGuardado\n        + Memento(LocalDateTime horaEntradaGuardada, LocalDateTime horaSalidaGuardada, double pagoGuardado)\n        + LocalDateTime getHoraEntradaGuardada()\n        + LocalDateTime getHoraSalidaGuardada()\n        + double getPagoGuardado()\n        + String toString()\n    }\n\n    class Caretaker {\n        - List~Memento~ listaMementos\n        + Caretaker()\n        + void addMemento(Memento memento)\n        + Memento getMemento(int index)\n        + List~Memento~ getListaMementos()\n    }\n\n    class Cliente {\n        + static void main(String[] args)\n    }\n\n    Vehiculo &lt;|-- Carro\n    Vehiculo &lt;|-- Moto\n    Vehiculo &lt;|-- Bus\n    Vehiculo ..&gt; Memento : crea / restaura\n    Caretaker o-- Memento : almacena historial\n    Cliente --&gt; Vehiculo : utiliza\n    Cliente --&gt; Caretaker : utiliza&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="m4i-jPkHkaMA8JjFsXAZ-1">
