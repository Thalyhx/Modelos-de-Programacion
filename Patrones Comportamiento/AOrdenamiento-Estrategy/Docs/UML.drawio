        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Cliente {\n        +main(args: String[]) void\n    }\n\n    class Contexto {\n        -algoritmo: AlgoritmoOrdenamiento\n        -Contexto()\n        +Contexto(algoritmo: AlgoritmoOrdenamiento)\n        +OrdenarLista(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n        +setAlgoritmo(algoritmo: AlgoritmoOrdenamiento) void\n    }\n\n    class FabricaSimpleEstrategia {\n        +crearAlgoritmo(tam: int) AlgoritmoOrdenamiento\n        +listaAleatoria(tam: int, min: int, max: int)$ List&lt;Integer&gt;\n    }\n\n    class AlgoritmoOrdenamiento {\n        &lt;&lt;interface&gt;&gt;\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n    }\n\n    class BubbleSort {\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n    }\n\n    class SelectionSort {\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n    }\n\n    class InsertionSort {\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n    }\n\n    class QuickSort {\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n        -quickSort(lista: List&lt;Integer&gt;, bajo: int, alto: int) void\n        +particion(lista: List&lt;Integer&gt;, bajo: int, alto: int) int\n    }\n\n    class HeapSort {\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n        -heapify(lista: List&lt;Integer&gt;, n: int, i: int) void\n    }\n\n    class MergeSort {\n        +ordenar(lista: List&lt;Integer&gt;) List&lt;Integer&gt;\n        -mergeSort(lista: List&lt;Integer&gt;, izquierda: int, derecha: int) void\n        -merge(lista: List&lt;Integer&gt;, izquierda: int, medio: int, derecha: int) void\n    }\n\n    %% Relaciones y dependencias\n    Cliente ..&gt; FabricaSimpleEstrategia : usa\n    Cliente ..&gt; Contexto : usa\n    Cliente ..&gt; AlgoritmoOrdenamiento : usa\n    \n    Contexto o--&gt; AlgoritmoOrdenamiento : tiene (estrategia actual)\n    \n    FabricaSimpleEstrategia ..&gt; AlgoritmoOrdenamiento : crea\n    \n    AlgoritmoOrdenamiento &lt;|.. BubbleSort : implementa\n    AlgoritmoOrdenamiento &lt;|.. SelectionSort : implementa\n    AlgoritmoOrdenamiento &lt;|.. InsertionSort : implementa\n    AlgoritmoOrdenamiento &lt;|.. QuickSort : implementa\n    AlgoritmoOrdenamiento &lt;|.. HeapSort : implementa\n    AlgoritmoOrdenamiento &lt;|.. MergeSort : implementa&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="-YBmZBIPbcXPYWfSc8NX-1">
