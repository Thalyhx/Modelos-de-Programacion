        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class Prestamo {\n        - String nombre\n        - int cedula\n        - int edad\n        - String ocupacion\n        - double monto\n        + Prestamo()\n        + Prestamo(String, int, int, String, double)\n        + getNombre() String\n        + getCedula() int\n        + getEdad() int\n        + getOcupacion() String\n        + getMonto() double\n        + setNombre(String) void\n        + setCedula(int) void\n        + setEdad(int) void\n        + setOcupacion(String) void\n        + setMonto(double) void\n    }\n\n    class Handler {\n        &lt;&lt;abstract&gt;&gt;\n        - Handler sucesor\n        + setNext(Handler sucesor) void\n        + getSucesor() Handler\n        + ProcesarPrestamo(Prestamo prestamo)*\n    }\n\n    class EjecutivoCuenta {\n        + ProcesarPrestamo(Prestamo prestamo)\n    }\n\n    class LiderInmediato {\n        + ProcesarPrestamo(Prestamo prestamo)\n    }\n\n    class Gerente {\n        + ProcesarPrestamo(Prestamo prestamo)\n    }\n\n    class Director {\n        + ProcesarPrestamo(Prestamo prestamo)\n    }\n\n    class Cliente {\n        + main(String[] args) void\n    }\n\n    %% Relaciones de Herencia (Generalización)\n    Handler &lt;|-- EjecutivoCuenta\n    Handler &lt;|-- LiderInmediato\n    Handler &lt;|-- Gerente\n    Handler &lt;|-- Director\n\n    %% Relación Reflexiva (Cadena / Sucesión)\n    Handler o-- Handler : sucesor\n\n    %% Relaciones de Uso / Dependencia\n    Cliente --&gt; Handler : instancia y encadena\n    Cliente --&gt; Prestamo : crea solicitud\n    Handler --&gt; Prestamo : evalúa\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="q6y7lKyjvQNU1pfNz746-1">
