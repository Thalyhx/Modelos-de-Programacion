        <mxCell id="46xFyZBu2M0XwCaObOTf-105" parent="1" style="shape=folder;fontStyle=1;spacingTop=10;tabWidth=40;tabHeight=14;tabPosition=left;html=1;whiteSpace=wrap;" value="&lt;font style=&quot;font-size: 24px;&quot;&gt;PRUEBA&lt;/font&gt;" vertex="1">
