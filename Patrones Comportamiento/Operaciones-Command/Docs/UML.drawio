        </mxCell>
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction LR\n\n    class Operacion {\n        &lt;&lt;interface&gt;&gt;\n        +double operar(double a, double b)\n        +double deshacer()\n    }\n\n    class Calculadora {\n        -double actual\n        -double googol\n        +double sumar(double a, double b)\n        +double restar(double a, double b)\n        +double multiplicar(double a, double b)\n        +double dividir(double a, double b)\n        +double aplicarGoogol(double a)\n        +double getActual()\n        +void setActual(double actual)\n        +double getGoogol()\n    }\n\n    class Invoker {\n        -Operacion operacion\n        +Invoker()\n        +Invoker(Operacion operacion)\n        +void ejecutarOperacion(double a, double b)\n        +double deshacer()\n        +void setOperacion(Operacion operacion)\n        +Operacion getOperacion()\n    }\n\n    class OperacionSumar {\n        -Calculadora calculadora\n        -double a\n        -double b\n        -double estadoAnterior\n        +OperacionSumar(Calculadora calculadora)\n        +double operar(double a, double b)\n        +double deshacer()\n    }\n\n    class OperacionRestar {\n        -Calculadora calculadora\n        -double a\n        -double b\n        -double estadoAnterior\n        +OperacionRestar(Calculadora calculadora)\n        +double operar(double a, double b)\n        +double deshacer()\n    }\n\n    class OperacionMultiplicar {\n        -Calculadora calculadora\n        -double a\n        -double b\n        -double estadoAnterior\n        +OperacionMultiplicar(Calculadora calculadora)\n        +double operar(double a, double b)\n        +double deshacer()\n    }\n\n    class OperacionDividir {\n        -Calculadora calculadora\n        -double a\n        -double b\n        -double estadoAnterior\n        +OperacionDividir(Calculadora calculadora)\n        +double operar(double a, double b)\n        +double deshacer()\n    }\n\n    class OperacionGoogol {\n        -Calculadora calculadora\n        -double estadoAnterior\n        +OperacionGoogol(Calculadora calculadora)\n        +double operar(double a, double b)\n        +double deshacer()\n    }\n\n    class Cliente {\n        +main(String[] args)\n    }\n\n    class PruebaCalculadora {\n        +main(String[] args)\n        +probarSuma()\n        +probarResta()\n        +probarMultiplicar()\n        +probarDividir()\n        +probarGoogol()\n    }\n\n    %% Relaciones\n    Operacion &lt;|.. OperacionSumar : implementa\n    Operacion &lt;|.. OperacionRestar : implementa\n    Operacion &lt;|.. OperacionMultiplicar : implementa\n    Operacion &lt;|.. OperacionDividir : implementa\n    Operacion &lt;|.. OperacionGoogol : implementa\n\n    Invoker o--&gt; Operacion : usa / almacena\n    \n    OperacionSumar --&gt; Calculadora : usa (Receiver)\n    OperacionRestar --&gt; Calculadora : usa (Receiver)\n    OperacionMultiplicar --&gt; Calculadora : usa (Receiver)\n    OperacionDividir --&gt; Calculadora : usa (Receiver)\n    OperacionGoogol --&gt; Calculadora : usa (Receiver)\n\n    Cliente --&gt; Invoker : crea\n    Cliente --&gt; Calculadora : crea\n    Cliente --&gt; OperacionSumar : instancia\n    Cliente --&gt; OperacionRestar : instancia\n    Cliente --&gt; OperacionMultiplicar : instancia\n    Cliente --&gt; OperacionDividir : instancia\n    Cliente --&gt; OperacionGoogol : instancia\n\n    PruebaCalculadora --&gt; Calculadora : prueba\n    PruebaCalculadora --&gt; OperacionSumar : prueba\n    PruebaCalculadora --&gt; OperacionRestar : prueba\n    PruebaCalculadora --&gt; OperacionMultiplicar : prueba\n    PruebaCalculadora --&gt; OperacionDividir : prueba\n    PruebaCalculadora --&gt; OperacionGoogol : prueba\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="46xFyZBu2M0XwCaObOTf-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
